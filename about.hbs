<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third party licenses - USB Flash Memory Toolset</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { background: #f4f4f4; padding: 1em; white-space: pre-wrap; }
</style>
</head>
<body>
<h1>Third party licenses</h1>
<p>The USB Flash Memory Toolset includes the following components.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li>{{name}}: {{count}}</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
